{
  "name": "@lornatang/dsh-caveman",
  "version": "0.1.0",
  "description": "Caveman integration for DeepSeek Harness.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Lornatang",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "caveman",
    "skills"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.2-rc.3"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-caveman": "./scripts/caveman-cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/caveman-cli.mjs",
    "upstream/skills",
    "upstream/src/hooks",
    "upstream/LICENSE",
    "upstream/LICENSE-MIT",
    "upstream/NOTICE",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "verify:upstream:git": "node scripts/verify-upstream-git.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:dsh": "node scripts/verify-dsh.mjs",
    "prepack": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@caveman-ai/cli": "4.1.0",
    "@caveman-ai/sdk": "1.2.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-loop": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-mcp-manager": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-native": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lornatang/dsh-caveman.git"
  },
  "homepage": "https://github.com/Lornatang/dsh-caveman#readme",
  "bugs": {
    "url": "https://github.com/Lornatang/dsh-caveman/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
